#!name=CCMTV 考勤助手 (Shadowrocket)
#!desc=固化考勤打卡坐标与地址为南部战区总医院(越秀院区)。采用前端DOM注入与提交接口兜底重写的“双保险”架构，彻底解除异地打卡与定位失败拦截；同时顺风车捕获有效会话凭据。
#!author=Nebuluxe[https://lmyz.1yo.cc]
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Hospital.png
#!date=2026-11-10 16:50:00

[MITM]
hostname = %APPEND% yun.ccmtv.cn

[Script]
# 1. 前端页面注入：拦截考勤页面 user_index，在 HTML 中注入位置常量补丁
ccmtv-inject = type=http-response,pattern=^https:\/\/yun\.ccmtv\.cn\/admin\.php\/nbzq\/Sign_in_clock_home\/user_index,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/LMuniverse/ApexApple_AE1/refs/heads/main/scripts/ccmtv/ccmtv_attendance.js

# 2. 提交接口兜底与凭据捕获：拦截考勤提交请求，强行改写 body 中的经纬度和地址为标准常量，并自动持久化 Cookie
ccmtv-submit = type=http-request,pattern=^https:\/\/yun\.ccmtv\.cn\/admin\.php\/nbzq\/Sign_in_clock_home\/(userMySignPost|userMySignPostFace|immediatelySignPost),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/LMuniverse/ApexApple_AE1/refs/heads/main/scripts/ccmtv/ccmtv_attendance.js
